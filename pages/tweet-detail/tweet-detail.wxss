/* pages/tweet-detail/tweet-detail.wxss */
.tweet-detail {
  min-height: 100vh;
  background: #f6f7fb;
  padding-bottom: 60rpx;
}

.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.hero-img {
  width: 100%;
  height: 420rpx;
  display: block;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
}

.hero-title {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 32rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  line-height: 1.3;
}

.content {
  padding: 36rpx 36rpx 0;
}

.summary {
  font-size: 30rpx;
  color: #555;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  line-height: 1.6;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.paragraph {
  font-size: 31rpx;
  color: #333;
  line-height: 1.9;
  margin-bottom: 26rpx;
  text-align: justify;
}

.inline-img {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
  display: block;
}

.link-area {
  margin-top: 24rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #ececec;
}

.link-btn {
  background: linear-gradient(135deg, #836fff, #5b8cff);
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 18rpx 0;
}

.link-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}
