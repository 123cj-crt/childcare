.list-wrap {
  min-height: 100vh;
  background: #f7f8fc;
  padding: 30rpx;
  box-sizing: border-box;
}
.list-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.list-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.list-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
}
.scroll-box {
  height: calc(100vh - 160rpx);
}
.notice-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.item-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  margin-bottom: 10rpx;
}
.item-time {
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 12rpx;
}
.item-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}
.empty-tip {
  margin-top: 200rpx;
  text-align: center;
  font-size: 28rpx;
  color: #bbb;
}