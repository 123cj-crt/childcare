/* ===== 页面背景 ===== */
page {
  background: linear-gradient(145deg, #f0f6ff 0%, #e6edf9 100%);
  min-height: 100vh;
}
/* ===== 页面容器 ===== */
.page {
  padding: 30rpx 24rpx 60rpx;
  box-sizing: border-box;
}
/* ===== 页面标题 ===== */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c3e7a;
  margin-bottom: 12rpx;
}
.page-sub {
  font-size: 26rpx;
  color: #9ca3af;
}
/* ===== 分组卡片 ===== */
.groups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.group-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 62, 122, 0.08);
  position: relative;
  overflow: hidden;
}
.group-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #4f7cff, #7c6af0);
  border-radius: 28rpx 28rpx 0 0;
}
/* ===== 儿童头部 ===== */
.child-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}
.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f7cff, #7c6af0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.child-avatar text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}
.child-info {
  flex: 1;
  min-width: 0;
}
.child-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2a44;
  margin-bottom: 6rpx;
}
.child-meta {
  font-size: 24rpx;
  color: #9ca3af;
}
.course-count {
  font-size: 26rpx;
  color: #4f7cff;
  font-weight: 600;
  background: linear-gradient(135deg, #dbeafe, #e0edff);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
/* ===== 课程列表 ===== */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.course-item {
  display: flex;
  align-items: stretch;
  background: #f8faff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  transition: background 0.2s;
}
.course-item:active {
  background: #e0edff;
}
.course-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  flex-shrink: 0;
}
.course-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #4f7cff;
}
.course-week {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.course-divider {
  width: 2rpx;
  background: #e2e8f0;
  margin: 0 20rpx;
  flex-shrink: 0;
}
.course-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a44;
  line-height: 1.4;
}
.course-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.course-time {
  font-size: 24rpx;
  color: #6b7280;
  background: #eef2f7;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.course-teacher {
  font-size: 24rpx;
  color: #6b7280;
}
.course-location {
  font-size: 24rpx;
  color: #9ca3af;
}
/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 34rpx;
  color: #6b7280;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
}