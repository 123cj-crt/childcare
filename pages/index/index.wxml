<!--index.wxml-->
<view class="container">
  <!-- 顶部轮播 -->
  <swiper class="banner" indicator-dots="true" autoplay="true" interval="3000" duration="500">
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <view class="banner-item" bindtap="onBannerTap" data-link="{{item.link}}" data-title="{{item.title}}">
          <image class="banner-img" src="{{item.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
          <view class="banner-overlay" wx:if="{{item.link}}">
            <view class="banner-title">{{item.title}}</view>
            <view class="banner-subtitle">点击查看详情</view>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>
  <!-- 最新课程区域 -->
  <view class="course-wrap">
    <view class="section-title">最新课程</view>
    <view class="course-list">
      <block wx:for="{{courses}}" wx:key="id">
        <view class="card course-item" bindtap="goToCourseDetail" data-id="{{item.id}}">
          <view class="course-info">
            <view class="course-name">{{item.name}}</view>
            <view class="course-meta">
              <view class="course-date-tag">{{item.date}}</view>
              <view class="course-week-tag">{{item.weekday}}</view>
              <view class="course-time-tag">{{item.time}}</view>
            </view>
            <view class="course-footer">
              <view class="course-location">📍 {{item.location}}</view>
              <view class="course-capacity">已报 {{item.currentStudents}}/{{item.capacity}}人</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view
    class="tax-agent-fab"
    wx:if="{{showTaxAgent}}"
    bindtap="goToTaxAgent"
    hover-class="tax-agent-fab-pressed"
    hover-stay-time="80"
  >
    <image class="tax-agent-fab-image" src="/images/tax-agent/mascot-fab-v2.png" mode="aspectFit" />
    <view class="tax-agent-fab-bubble">问问小税宝</view>
  </view>
</view>
