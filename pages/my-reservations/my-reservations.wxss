/* ===== 页面背景 ===== */
page {
  background: linear-gradient(145deg, #f0f6ff 0%, #e6edf9 100%);
  min-height: 100vh;
  padding: 30rpx 0;
  box-sizing: border-box;
}
.page {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  padding: 0 20rpx;
  box-sizing: border-box;
}
/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 200rpx 0;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 36rpx;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.empty-sub {
  font-size: 28rpx;
  color: #9ca3af;
}
/* ===== 列表头部 ===== */
.list-header {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2a44;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}
/* ===== 预约卡片 ===== */
.reservation-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 62, 122, 0.08);
  position: relative;
  overflow: hidden;
}
.reservation-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #4f7cff, #7c6af0);
  border-radius: 28rpx 28rpx 0 0;
}
/* ===== 课程名称 ===== */
.course-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2a44;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
/* ===== 预约儿童徽章 ===== */
.child-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 2rpx solid #fcd34d;
  border-radius: 50rpx;
  padding: 6rpx 24rpx 6rpx 6rpx;
  margin-bottom: 20rpx;
  align-self: flex-start;
}
.badge-avatar {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}
.badge-info {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 500;
}
/* ===== 标签行 ===== */
.tags-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}
.tag-date {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
}
.tag-week {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  color: #5b21b6;
}
.tag-time {
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
  color: #9d174d;
}
/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}
.info-row:last-of-type {
  border-bottom: none;
}
.info-label {
  font-size: 28rpx;
  color: #9ca3af;
  width: 160rpx;
  flex-shrink: 0;
}
.info-value {
  font-size: 28rpx;
  color: #2d3748;
  flex: 1;
  line-height: 1.6;
}
.phone-link {
  color: #3b82f6;
  font-weight: 500;
}
.reserved-time {
  color: #9ca3af;
  font-size: 26rpx;
}
/* ===== 取消按钮 ===== */
.cancel-btn-wrap {
  margin-top: 24rpx;
  text-align: center;
}
.cancel-btn {
  width: 100%;
  max-width: 400rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(239, 68, 68, 0.25);
  border: none;
}
.cancel-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.20);
}