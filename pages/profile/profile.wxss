/**profile.wxss**/
page{
  background: linear-gradient(to right, #f5e6ee, #e5fdf1);
}

.profile-page {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.username {
  font-size: 55rpx;
  font-weight: bold;
  color: #333;
}

.login-section {
  margin-top: 30rpx;
}

.login-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.3);
}

.menu-list {
  margin-bottom: 80rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.tab-item.active {
  color: #0ea5e9;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.names {
  font-size: 40rpx;
}