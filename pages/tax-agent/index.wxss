.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx calc(146rpx + env(safe-area-inset-bottom)); background: #f5fbf8; }
.home-hero { position: relative; min-height: 322rpx; overflow: hidden; border-radius: 36rpx; box-shadow: 0 16rpx 34rpx rgba(33, 120, 99, .12); }
.hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-shade { background: linear-gradient(90deg, rgba(245, 255, 251, .95) 0%, rgba(245, 255, 251, .76) 42%, rgba(245, 255, 251, .08) 76%); }
.hero-copy { position: relative; z-index: 1; width: 480rpx; padding: 42rpx 34rpx; }
.hero-badge, .weekly-label { display: inline-block; padding: 7rpx 16rpx; border-radius: 24rpx; background: #218d79; color: #fff; font-size: 21rpx; font-weight: 700; }
.hero-title { margin-top: 18rpx; color: #0f5a4b; font-size: 42rpx; line-height: 1.25; font-weight: 700; }
.hero-desc { margin-top: 14rpx; color: #45776d; font-size: 24rpx; line-height: 1.62; }
.feature-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }
.feature-card { flex: 1; min-width: 0; padding: 24rpx 14rpx 22rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(37, 115, 96, .08); text-align: center; }
.feature-icon { display: block; width: 82rpx; height: 82rpx; margin: -4rpx auto 10rpx; }
.feature-title { color: #24443d; font-size: 27rpx; font-weight: 700; white-space: nowrap; }.feature-desc { min-height: 54rpx; margin-top: 8rpx; color: #829993; font-size: 20rpx; line-height: 1.35; }
.learning-section { margin-top: 28rpx; padding: 26rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(37, 115, 96, .06); }
.section-heading { display: flex; align-items: center; justify-content: space-between; }.section-title { color: #24443d; font-size: 32rpx; font-weight: 700; }.section-mark { display: inline-block; width: 38rpx; height: 38rpx; margin-right: 10rpx; border-radius: 12rpx; background: #1fa087; color: #fff; font-size: 25rpx; line-height: 38rpx; text-align: center; }.section-mark.warm { background: #ffb627; }.section-link { color: #6b958b; font-size: 22rpx; }
.task-card { display: flex; gap: 18rpx; margin-top: 22rpx; padding: 12rpx; border-radius: 24rpx; background: #eff9f5; }.task-image { flex: 0 0 182rpx; width: 182rpx; height: 202rpx; border-radius: 18rpx; }.task-copy { flex: 1; min-width: 0; padding: 8rpx 4rpx; }.task-kicker { color: #1b997f; font-size: 21rpx; font-weight: 700; }.task-title { margin-top: 8rpx; color: #23443d; font-size: 27rpx; line-height: 1.35; font-weight: 700; }.task-desc { margin-top: 8rpx; color: #6f8c85; font-size: 21rpx; line-height: 1.45; }.task-button { display: inline-block; margin-top: 12rpx; padding: 9rpx 24rpx; border-radius: 28rpx; background: #1e9b89; color: #fff; font-size: 22rpx; font-weight: 700; }
.weekly-list { display: flex; gap: 16rpx; margin-top: 22rpx; }.weekly-card { position: relative; flex: 1; min-width: 0; min-height: 178rpx; padding: 22rpx; overflow: hidden; border-radius: 22rpx; }.weekly-green { background: #eaf8f2; }.weekly-blue { background: #eaf4ff; }.weekly-blue .weekly-label { background: #4d8dd8; }.weekly-title { margin-top: 12rpx; color: #294840; font-size: 26rpx; line-height: 1.28; font-weight: 700; }.weekly-desc { margin-top: 8rpx; color: #69877f; font-size: 20rpx; line-height: 1.4; }.weekly-arrow { position: absolute; right: 18rpx; bottom: 16rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #299d87; color: #fff; line-height: 36rpx; text-align: center; }.weekly-blue .weekly-arrow { background: #4d8dd8; }
.service-status { margin-top: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fff3e9; color: #9a6630; font-size: 25rpx; text-align: center; }.service-retry { display: inline-block; margin-top: 16rpx; padding: 12rpx 22rpx; border-radius: 24rpx; background: #1e9b89; color: #fff; }
