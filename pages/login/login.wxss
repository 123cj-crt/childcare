.login-wrap {
  /* 垂直居中，解决底部大片空白 */
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.subtitle-tip {
  text-align: center;
  margin: -60rpx 0 80rpx;
}
/* 勾选框文字横向对齐 */
.agree-box {
  width: 86%;
  margin: 60rpx auto 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.agree-box label {
  display: flex;
  flex-wrap: wrap;
}
.link {
  color: #63a8ff;
  margin: 0 6rpx;
}
.userinfo-container {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  align-items: center;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.nickname-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 20rpx;
}