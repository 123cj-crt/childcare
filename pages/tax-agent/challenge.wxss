.page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(146rpx + env(safe-area-inset-bottom)); background: #f5fbf8; }
.challenge-hero { position: relative; height: 276rpx; overflow: hidden; border-radius: 0 0 36rpx 36rpx; }.challenge-hero-image, .challenge-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }.challenge-hero-shade { background: linear-gradient(90deg, rgba(245, 255, 251, .97), rgba(245, 255, 251, .72) 48%, rgba(245, 255, 251, .06)); }.challenge-hero-copy { position: relative; z-index: 1; width: 490rpx; padding: 58rpx 36rpx; }.challenge-hero-title { color: #0f5b4b; font-size: 43rpx; font-weight: 700; }.challenge-hero-desc { margin-top: 14rpx; color: #5e8179; font-size: 25rpx; line-height: 1.56; }
.topic-page { padding: 26rpx 24rpx; }.topic-intro { margin-bottom: 18rpx; color: #718b85; font-size: 24rpx; line-height: 1.62; }.topic-intro-title { margin-bottom: 6rpx; color: #26413c; font-size: 32rpx; font-weight: 700; }.topic-card { display: flex; align-items: center; margin-top: 18rpx; padding: 22rpx 20rpx; border: 1rpx solid #dcefe8; border-radius: 26rpx; background: #fff; box-shadow: 0 9rpx 22rpx rgba(31, 128, 112, .055); }.topic-icon { display: block; flex: 0 0 84rpx; width: 84rpx; height: 84rpx; }.topic-copy { flex: 1; min-width: 0; margin-left: 20rpx; }.topic-title { color: #26413c; font-size: 30rpx; font-weight: 700; }.topic-desc { margin-top: 7rpx; color: #7d958f; font-size: 22rpx; line-height: 1.42; }.topic-count { margin-left: 12rpx; padding: 9rpx 14rpx; border-radius: 20rpx; background: #e9f7f2; color: #228a79; font-size: 21rpx; font-weight: 700; }.topic-arrow { margin-left: 12rpx; color: #6fa195; font-size: 46rpx; line-height: 1; }
