/* pages/notice-list/notice-list.wxss */
.notice-list-page {
  min-height: 100vh;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}
/* 顶部标题区 */
.list-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}
.header-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.header-sub {
  font-size: 26rpx;
  color: #999;
}
/* 公告列表 */
.list-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
}
.notice-card:active {
  transform: scale(0.98);
  opacity: 0.92;
}
.notice-card.read {
  opacity: 0.75;
}
.card-left {
  flex-shrink: 0;
}
.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}
.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d4f;
  flex-shrink: 0;
}
.card-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.card-time {
  font-size: 24rpx;
  color: #aaa;
}
.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}
/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}