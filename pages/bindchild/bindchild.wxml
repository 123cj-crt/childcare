<!--pages/bindchild/bindchild.wxml-->
<view class="page">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title">已绑定儿童</view>
    <view class="page-sub">管理您需要预约课程的儿童信息</view>
  </view>
  <!-- 儿童列表 -->
  <view class="children-list" wx:if="{{children.length > 0}}">
    <view class="child-card" wx:for="{{children}}" wx:key="id">
      <view class="child-header">
        <view class="child-avatar">
          <text>{{item.name[0]}}</text>
        </view>
        <view class="child-name">{{item.name}}</view>
        <view class="child-delete" catchtap="onDeleteChild" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
      <view class="child-info">
        <view class="info-row">
          <text class="info-label">年龄</text>
          <text class="info-value">{{item.age}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">性别</text>
          <text class="info-value">{{item.gender}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">关系</text>
          <text class="info-value">{{item.relation}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">家长姓名</text>
          <text class="info-value">{{item.parentName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">家长电话</text>
          <text class="info-value">{{item.phoneNumber || '未填写'}}</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">👶</view>
    <view class="empty-text">暂无绑定儿童</view>
    <view class="empty-hint">请添加儿童信息，用于预约课程</view>
  </view>
  <!-- 添加按钮 -->
  <view class="add-btn-wrap" wx:if="{{!showForm}}">
    <button class="add-btn" bindtap="onShowForm">+ 添加儿童</button>
  </view>
  <!-- 添加表单弹窗 -->
  <view class="form-mask" wx:if="{{showForm}}" bindtap="onHideForm">
    <view class="form-panel" catchtap="stopBubble">
      <view class="form-title">添加儿童信息</view>
      <view class="form-group">
        <view class="form-label">儿童姓名 <text class="required">*</text></view>
        <input class="form-input" placeholder="请输入儿童姓名" value="{{formData.name}}" data-field="name" bindinput="onInputChange" />
      </view>
      <view class="form-group">
        <view class="form-label">年龄 <text class="required">*</text></view>
        <input class="form-input" placeholder="如：6岁" value="{{formData.age}}" data-field="age" bindinput="onInputChange" />
      </view>
      <view class="form-group">
        <view class="form-label">性别</view>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderOptions.indexOf(formData.gender)}}" bindchange="onGenderChange">
          <view class="form-picker">{{formData.gender}}</view>
        </picker>
      </view>
      <view class="form-group">
        <view class="form-label">与儿童关系 <text class="required">*</text></view>
        <input class="form-input" placeholder="如：爸爸、妈妈" value="{{formData.relation}}" data-field="relation" bindinput="onInputChange" />
      </view>
      <view class="form-group">
        <view class="form-label">家长姓名</view>
        <input class="form-input" placeholder="请输入家长姓名" value="{{formData.parentName}}" data-field="parentName" bindinput="onInputChange" />
      </view>
      <view class="form-group">
        <view class="form-label">家长电话</view>
        <input class="form-input" type="number" placeholder="请输入家长电话" value="{{formData.phoneNumber}}" data-field="phoneNumber" bindinput="onInputChange" />
      </view>
      <view class="form-actions">
        <button class="form-btn form-btn-cancel" catchtap="onHideForm">取消</button>
        <button class="form-btn form-btn-save" catchtap="onSaveChild">保存</button>
      </view>
    </view>
  </view>
</view>