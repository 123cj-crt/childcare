/* pages/history-courses/history-courses.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fc;
}

/* ========== Hero 区（与其他页面统一） ========== */
.page-hero {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 60%, #7ec8f5 100%);
  overflow: hidden;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
}
.page-hero::before {
  content: "";
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  top: -80rpx;
  right: -80rpx;
}
.page-hero::after {
  content: "";
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  bottom: -60rpx;
  left: -40rpx;
}
.hero-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.hero-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}
.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========== 主体内容 ========== */
.page-body {
  margin-top: -40rpx;
  padding: 0 30rpx 60rpx;
  position: relative;
  z-index: 3;
}

/* ========== 演示提示 ========== */
.demo-tip {
  background: rgba(255, 196, 0, 0.12);
  border: 1rpx solid rgba(255, 196, 0, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.demo-tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}
.demo-tip-text {
  font-size: 24rpx;
  color: #b8860b;
  line-height: 1.4;
  flex: 1;
}

/* ========== 空状态 ========== */
.empty-state {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* ========== 历史课程列表 ========== */
.list-header {
  font-size: 28rpx;
  color: #888;
  padding: 0 10rpx 20rpx;
}

.history-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
  position: relative;
  overflow: hidden;
}

.card-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #836fff 0%, #63a8ff 100%);
}

/* 已完成徽章 */
.completed-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(82, 196, 26, 0.1);
  border: 1rpx solid rgba(82, 196, 26, 0.3);
  border-radius: 30rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
}
.completed-icon {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: bold;
}
.completed-text {
  font-size: 22rpx;
  color: #52c41a;
}

/* 课程名 */
.course-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

/* 儿童徽章 */
.child-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(131, 111, 255, 0.06);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.badge-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 100%);
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}
.badge-info {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.tag-date {
  background: rgba(131, 111, 255, 0.1);
  color: #836fff;
}
.tag-week {
  background: rgba(99, 168, 255, 0.1);
  color: #63a8ff;
}
.tag-time {
  background: rgba(126, 200, 245, 0.15);
  color: #4a90d9;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}
.phone-link {
  color: #836fff;
}
.reserved-time {
  color: #999;
  font-size: 24rpx;
}
