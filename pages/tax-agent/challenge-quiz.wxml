<view class="page"><view class="topbar"><view><view class="topbar-title">{{topic.title}}</view><view class="topbar-desc">完成全部 {{topic.count}} 道小挑战</view></view><view class="score">得分 {{score}}</view></view><view class="quiz" wx:if="{{!isLoading && !complete && currentQuestion}}"><view class="progress">第 {{currentIndex + 1}} / {{topic.count}} 题</view><view class="question">{{currentQuestion.prompt}}</view><view class="option-list"><view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="option {{selectedOptionKey === item.option_key ? 'selected' : ''}}" bindtap="selectOption" data-option-key="{{item.option_key}}"><view class="option-label">{{item.option_key}}</view><view>{{item.content}}</view></view></view><view class="feedback {{isCorrect ? 'good' : 'try'}}" wx:if="{{answered}}"><view class="feedback-title">{{isCorrect ? '答对啦！' : '再想一想'}}</view><view>{{explanation}}</view></view><view class="request-error" wx:if="{{errorMessage}}"><view>{{errorMessage}}</view><view class="retry-button" bindtap="retrySubmit">重新提交</view></view><view class="primary-button" wx:if="{{!answered}}" bindtap="checkAnswer">{{isSubmitting ? '正在提交…' : '确认答案'}}</view><view class="primary-button" wx:else bindtap="nextQuestion">{{nextQuestion ? '下一题' : '查看结果'}}</view></view><view class="result" wx:if="{{!isLoading && complete}}"><view class="result-badge">完成</view><view class="result-title">你答对了 {{score}} 题</view><view class="result-desc">{{score >= 2 ? '真棒！你正在把财税知识用到生活里。' : '认真思考就是收获，再试一次会更熟练。'}}</view><view class="primary-button" bindtap="startQuiz">再玩一次</view><view class="secondary-button" bindtap="chooseAnotherTopic">换个主题</view></view><view class="loading" wx:if="{{isLoading}}">题目正在准备中…</view><view class="empty-state" wx:if="{{!isLoading && !complete && !currentQuestion && errorMessage}}"><view>{{errorMessage}}</view><view class="primary-button" bindtap="startQuiz">重新开始</view><view class="secondary-button" bindtap="chooseAnotherTopic">换个主题</view></view></view>
