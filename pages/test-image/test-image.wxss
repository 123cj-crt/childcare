/* test-image.wxss */
.container {
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.test-btn {
  background-color: #4cd964;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.image-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.image-item {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  background: white;
}

.image-info {
  margin-bottom: 20rpx;
}

.image-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.image-url {
  display: block;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.test-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}
