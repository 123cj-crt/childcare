page { height: 100%; overflow: hidden; }
.page { display: flex; flex-direction: column; height: calc(100vh - 112rpx - env(safe-area-inset-bottom)); min-height: 0; overflow: hidden; background: #f5fbf8; }
.chat-hero { position: relative; flex: 0 0 190rpx; overflow: hidden; border-bottom: 1rpx solid #dceee8; }.chat-hero-image, .chat-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }.chat-hero-shade { background: linear-gradient(90deg, rgba(245, 255, 251, .96), rgba(245, 255, 251, .74) 46%, rgba(245, 255, 251, .08)); }.chat-hero-copy { position: relative; z-index: 1; padding: 40rpx 32rpx; }.chat-title { color: #0d5d4d; font-size: 42rpx; font-weight: 700; }.chat-subtitle { margin-top: 10rpx; color: #64877f; font-size: 25rpx; }.clear-button { position: absolute; z-index: 2; top: 28rpx; right: 28rpx; padding: 12rpx 20rpx; border-radius: 28rpx; background: rgba(255, 255, 255, .9); color: #238a77; font-size: 23rpx; font-weight: 700; }
.ai-disclosure { display: inline-flex; align-items: center; max-width: 520rpx; margin-top: 10rpx; padding: 5rpx 14rpx 5rpx 9rpx; border: 1rpx solid rgba(113, 175, 160, .34); border-radius: 24rpx; background: rgba(255, 255, 255, .76); color: #52766e; }
.ai-disclosure-badge { margin-right: 9rpx; padding: 1rpx 8rpx; border-radius: 12rpx; background: #e3f4ef; color: #218d79; font-size: 17rpx; font-weight: 700; line-height: 1.45; }
.ai-disclosure-text { font-size: 19rpx; line-height: 1.45; white-space: nowrap; }
.message-list { flex: 1; height: 0; min-height: 0; padding: 26rpx 28rpx 16rpx; box-sizing: border-box; overscroll-behavior: contain; }.message-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; }.message-row.user { flex-direction: row-reverse; }.avatar, .avatar-image { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; border-radius: 50%; }.avatar-image { border: 2rpx solid #d9f2ea; }.user-avatar { background: #dceafb; color: #4f7fc8; font-size: 25rpx; font-weight: 700; line-height: 58rpx; text-align: center; }.message-content { max-width: 530rpx; margin-left: 16rpx; }.user .message-content { margin-right: 16rpx; margin-left: 0; }.message-bubble { box-sizing: border-box; padding: 20rpx 24rpx; border-radius: 10rpx 26rpx 26rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(38, 115, 96, .06); color: #304742; font-size: 28rpx; line-height: 1.7; overflow-wrap: anywhere; word-break: break-word; }.user .message-bubble { border-radius: 26rpx 10rpx 26rpx 26rpx; background: #209b86; color: #fff; }.markdown-block { white-space: pre-wrap; }.markdown-block + .markdown-block { margin-top: 16rpx; }.markdown-quote { padding-left: 16rpx; border-left: 5rpx solid #9dd8cd; color: #52746d; }.markdown-list-item { display: flex; align-items: flex-start; }.markdown-list-item + .markdown-list-item { margin-top: 8rpx; }.markdown-list-marker { flex: 0 0 28rpx; color: #1e9b89; font-weight: 700; }.markdown-list-content { flex: 1; }.markdown-strong { color: #197b6d; font-weight: 700; }.chat-bottom-anchor { height: 2rpx; }
.typing { display: flex; align-items: center; gap: 8rpx; padding-left: 74rpx; color: #7f9691; font-size: 24rpx; }.typing-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7ebeb3; }.request-error { margin: 0 0 24rpx 74rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #fff3e9; color: #a66b32; font-size: 24rpx; line-height: 1.5; }.retry-button { display: inline-block; margin-top: 12rpx; padding: 8rpx 16rpx; border-radius: 20rpx; background: #1e9b89; color: #fff; }
.quick-section { display: flex; align-items: center; min-height: 94rpx; padding: 14rpx 28rpx; box-sizing: border-box; background: #fff; border-top: 1rpx solid #e4f0ec; }.quick-title { flex: 0 0 auto; margin-right: 16rpx; color: #218d79; font-size: 24rpx; font-weight: 700; white-space: nowrap; }.quick-list { flex: 1; width: 0; min-width: 0; white-space: nowrap; }.quick-item { display: inline-block; max-width: 330rpx; margin-right: 12rpx; padding: 12rpx 20rpx; overflow: hidden; box-sizing: border-box; border: 1rpx solid #d9eee8; border-radius: 30rpx; background: #edf9f5; color: #2c766c; font-size: 22rpx; line-height: 1.35; text-overflow: ellipsis; vertical-align: middle; white-space: nowrap; }
.input-bar { display: flex; align-items: center; padding: 14rpx 28rpx; background: #fff; border-top: 1rpx solid #e9f0ee; }.message-input { flex: 1; height: 76rpx; padding: 0 24rpx; border-radius: 38rpx; background: #f2f7f6; color: #2b403c; font-size: 27rpx; }.send-button { margin-left: 16rpx; padding: 19rpx 26rpx; border-radius: 36rpx; background: #d9e7e4; color: #fff; font-size: 25rpx; font-weight: 700; }.send-button.active { background: #1e9b89; }
