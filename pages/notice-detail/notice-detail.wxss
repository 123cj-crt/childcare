/* pages/notice-detail/notice-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 60rpx;
}
/* 顶部头图区 */
.detail-hero {
  position: relative;
  padding: 60rpx 40rpx 100rpx;
  color: #fff;
  overflow: hidden;
}
.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
}
.hero-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}
.hero-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.hero-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.hero-time {
  font-size: 26rpx;
  opacity: 0.9;
}
.hero-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 20rpx;
}
/* 波浪装饰 */
.hero-wave {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100%;
  height: 60rpx;
  z-index: 1;
}
.hero-wave svg {
  width: 100%;
  height: 100%;
}
/* 正文内容区 */
.detail-body {
  padding: 20rpx 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.section-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.section-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.section-step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}
.section-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 20rpx;
  white-space: pre-line;
}
.section-tips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}
.tip-text {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}
/* 底部 */
.detail-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 60rpx 40rpx;
}
.footer-line {
  width: 80rpx;
  height: 2rpx;
  background: #ddd;
}
.footer-text {
  font-size: 24rpx;
  color: #bbb;
}