.page { min-height: 100vh; background: #f7fbfa; }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 42rpx 30rpx; background: #1e9b89; color: #fff; }
.topbar-title { font-size: 40rpx; font-weight: 700; }
.topbar-desc { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,.85); }
.score { padding: 14rpx 20rpx; border-radius: 28rpx; background: rgba(255,255,255,.16); font-size: 25rpx; }
.topic-page { padding: 28rpx; }
.topic-intro { margin-bottom: 24rpx; color: #718b85; font-size: 26rpx; line-height: 1.65; }
.topic-intro-title { color: #26413c; font-size: 36rpx; font-weight: 700; }
.topic-card { display: flex; align-items: center; margin-top: 18rpx; padding: 26rpx 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(31, 128, 112, .06); }
.topic-icon { width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 22rpx; background: #e6f8f3; color: #1e9b89; font-size: 32rpx; font-weight: 700; }
.topic-copy { flex: 1; margin-left: 20rpx; }.topic-title { color: #26413c; font-size: 30rpx; font-weight: 700; }.topic-desc { margin-top: 6rpx; color: #7d958f; font-size: 23rpx; }.topic-arrow { color: #86aaa3; font-size: 46rpx; }
.quiz { margin: 30rpx 28rpx; padding: 32rpx 28rpx; border-radius: 26rpx; background: #fff; }
.quiz-topic { display: inline-block; padding: 7rpx 14rpx; border-radius: 16rpx; background: #e8f8f4; color: #228a79; font-size: 22rpx; font-weight: 700; }
.progress { color: #5e9c92; font-size: 24rpx; font-weight: 700; }
.question { margin-top: 22rpx; color: #26413c; font-size: 34rpx; line-height: 1.5; font-weight: 700; }
.option-list { margin-top: 30rpx; }
.option { display: flex; align-items: center; margin-top: 16rpx; padding: 20rpx; border: 2rpx solid #e5efed; border-radius: 18rpx; color: #405a55; font-size: 28rpx; }
.option.selected { border-color: #56b8a8; background: #edfaf7; }
.option-label { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; margin-right: 16rpx; border-radius: 50%; background: #edf5f3; color: #60958b; font-size: 23rpx; font-weight: 700; }
.feedback { margin-top: 28rpx; padding: 22rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.65; }
.feedback.good { background: #e7f8f0; color: #27785f; }
.feedback.try { background: #fff3e9; color: #a66b32; }
.feedback-title { margin-bottom: 8rpx; font-size: 30rpx; font-weight: 700; }
.primary-button { margin-top: 30rpx; padding: 22rpx; border-radius: 18rpx; background: #1e9b89; color: #fff; text-align: center; font-size: 30rpx; font-weight: 700; }
.secondary-button { margin-top: 18rpx; padding: 18rpx; border-radius: 18rpx; color: #278b7b; text-align: center; font-size: 27rpx; }
.result { margin: 120rpx 48rpx; padding: 56rpx 32rpx; border-radius: 28rpx; background: #fff; text-align: center; }
.result-badge { display: inline-block; padding: 10rpx 18rpx; border-radius: 28rpx; background: #e8f8f4; color: #208b79; font-size: 24rpx; }
.result-title { margin-top: 24rpx; color: #27423d; font-size: 42rpx; font-weight: 700; }
.result-desc { margin-top: 16rpx; color: #718b85; font-size: 27rpx; }
.loading { padding: 140rpx 0; color: #7d958f; text-align: center; font-size: 28rpx; }
.request-error { margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: #fff3e9; color: #a66b32; font-size: 25rpx; line-height: 1.6; }
.retry-button { display: inline-block; margin-top: 12rpx; padding: 8rpx 16rpx; border-radius: 20rpx; background: #1e9b89; color: #fff; }
.empty-state { margin: 90rpx 40rpx; color: #7d958f; text-align: center; font-size: 28rpx; }
