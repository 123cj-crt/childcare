/* ========== 页面整体容器 ========== */
.container {
  padding: 0 0 40rpx;
  box-sizing: border-box;
}

/* ========== 轮播 ========== */
.banner {
  width: 100%;
  height: 320rpx;
}
.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 28rpx 28rpx;
}
.banner-img {
  width: 100%;
  height: 100%;
}
.banner-overlay {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
}
.banner-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
}
.banner-subtitle {
  font-size: 24rpx;
  color: #eee;
  margin-top: 8rpx;
}

/* ========== 课程区域 ========== */
.course-wrap {
  margin-top: 20rpx;
  padding: 0 30rpx;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 30rpx;
}

/* ========== 课程卡片 ========== */
.course-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.10);
  transition: transform 0.2s;
}
.course-card:active {
  transform: scale(0.99);
  background: #f5f7fc;
}

.course-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 18rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.course-date-tag,
.course-week-tag,
.course-time-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 500;
}
.course-date-tag {
  background: linear-gradient(135deg, rgba(131, 111, 255, 0.12), rgba(99, 168, 255, 0.12));
  color: #836fff;
}
.course-week-tag {
  background: rgba(99, 168, 255, 0.1);
  color: #63a8ff;
}
.course-time-tag {
  background: rgba(131, 111, 255, 0.08);
  color: #836fff;
}

.course-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.course-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f2f5;
  font-size: 24rpx;
}
.course-location {
  color: #8c8c8c;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.course-capacity {
  color: #836fff;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ========== 财税智能体悬浮入口 ========== */
.tax-agent-fab {
  position: fixed;
  right: 18rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 160ms ease, transform 160ms ease;
}
.tax-agent-fab-bubble {
  margin-top: -10rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid #d8f1e9;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(31, 125, 105, .14);
  color: #168b75;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}
.tax-agent-fab-image {
  width: 128rpx;
  height: 172rpx;
}
.tax-agent-fab-pressed {
  opacity: .9;
  transform: scale(.96);
}