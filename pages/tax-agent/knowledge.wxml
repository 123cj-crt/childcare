<view class="page">
  <view class="intro">
    <view class="intro-kicker">一分钟小知识</view>
    <view class="intro-title">把生活里的问题<br />变成新发现</view>
    <view class="intro-desc">点开每张卡片，看看小税怎么解释。</view>
  </view>

  <view class="card-list" wx:if="{{!isLoading}}">
    <view class="knowledge-card" wx:for="{{cards}}" wx:key="id" bindtap="toggleCard" data-id="{{item.id}}">
      <view class="card-head">
        <view class="card-icon">{{item.icon}}</view>
        <view class="card-title">{{item.title}}</view>
        <view class="card-arrow">{{activeCardId === item.id ? '−' : '+'}}</view>
      </view>
      <view class="card-summary">{{item.summary}}</view>
      <view class="card-detail" wx:if="{{activeCardId === item.id}}">{{item.detail}}</view>
    </view>
  </view>
  <view class="loading" wx:else>知识卡片正在准备中…</view>
</view>
