/* pages/attendance-admin/attendance-admin.wxss */
.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6fa;
  box-sizing: border-box;
}

.login-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.login-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #2d3748;
  text-align: center;
}

.login-sub {
  font-size: 26rpx;
  color: #a0aec0;
  text-align: center;
  margin-top: 12rpx;
}

.pwd-input {
  margin-top: 40rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 32rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.login-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #cbd5e0;
  text-align: center;
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.admin-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d3748;
}

.course-picker {
  font-size: 28rpx;
  color: #667eea;
  background: #edf2ff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
}

.tip {
  text-align: center;
  color: #a0aec0;
  margin-top: 80rpx;
  font-size: 28rpx;
}

.student-list {
  margin-top: 24rpx;
}

.student-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 20rpx;
}

.status-row {
  display: flex;
}

.status-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  color: #718096;
  font-size: 26rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.status-btn:last-child {
  margin-right: 0;
}

.status-btn.active.present {
  background: #e6fffa;
  border-color: #38b2ac;
  color: #319795;
}

.status-btn.active.late {
  background: #fffaf0;
  border-color: #dd9b20;
  color: #b7791f;
}

.status-btn.active.absent {
  background: #fff5f5;
  border-color: #e53e3e;
  color: #e53e3e;
}

.feedback-input {
  margin-top: 20rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 32rpx;
  background: #667eea;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.ph {
  color: #cbd5e0;
}
