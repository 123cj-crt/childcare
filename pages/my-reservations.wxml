<!--pages/my-reservations/my-reservations.wxml-->
<view class="page">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无预约课程</view>
    <view class="empty-sub">去首页预约感兴趣的课程吧</view>
  </view>
  <!-- 预约列表 -->
  <view class="reservation-list" wx:else>
    <view class="list-header">我的预约（{{reservations.length}}）</view>
    <view class="reservation-card" wx:for="{{reservations}}" wx:key="courseId">
      <!-- 课程标题 -->
      <view class="course-name">{{item.courseName}}</view>
      <!-- 标签 -->
      <view class="tags-row">
        <text class="tag tag-date">{{item.date}}</text>
        <text class="tag tag-week">{{item.weekday}}</text>
        <text class="tag tag-time">{{item.time}}</text>
      </view>
      <!-- 上课地点 -->
      <view class="info-row">
        <text class="info-label">上课地点</text>
        <text class="info-value">{{item.location}}</text>
      </view>
      <!-- 教师信息 -->
      <view class="info-row">
        <text class="info-label">授课教师</text>
        <text class="info-value">{{item.teacher}}</text>
      </view>
      <!-- 联系电话 -->
      <view class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value phone-link" bindtap="makePhoneCall" data-phone="{{item.teacherPhone}}">{{item.teacherPhone}}（点击拨打）</text>
      </view>
      <!-- 课程容量 -->
      <view class="info-row">
        <text class="info-label">课程容量</text>
        <text class="info-value">{{item.capacity}}人</text>
      </view>
      <!-- 预约时间 -->
      <view class="info-row">
        <text class="info-label">预约时间</text>
        <text class="info-value reserved-time">{{item.reservedAt}}</text>
      </view>
      <!-- 取消按钮 -->
      <view class="cancel-btn-wrap">
        <button class="cancel-btn" bindtap="onCancelReservation" data-id="{{item.courseId}}" data-name="{{item.courseName}}">取消预约</button>
      </view>
    </view>
  </view>
</view>