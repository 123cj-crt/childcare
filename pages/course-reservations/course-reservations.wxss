/* pages/course-reservations/course-reservations.wxss */
.resv-page {
  padding: 0;
  min-height: 100vh;
  background: #f5f7fc;
  box-sizing: border-box;
}

/* ========== Hero 区 ========== */
.page-hero {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 60%, #7ec8f5 100%);
  overflow: hidden;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
}
.page-hero::before {
  content: "";
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  top: -80rpx;
  right: -80rpx;
}
.page-hero::after {
  content: "";
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  bottom: -60rpx;
  left: -40rpx;
}
.hero-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.hero-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}
.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========== 主体内容 ========== */
.page-body {
  margin-top: -40rpx;
  padding: 0 30rpx 60rpx;
  position: relative;
  z-index: 3;
}

/* ========== 课程选择器 ========== */
.course-picker-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
}
.picker-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f5f7fc;
  border-radius: 16rpx;
}
.picker-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  font-size: 24rpx;
  color: #836fff;
  margin-left: 16rpx;
}
.course-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.meta-item {
  font-size: 24rpx;
  color: #666;
  background: rgba(131, 111, 255, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 统计栏 ========== */
.stats-bar {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #836fff;
}
.stat-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}
.stat-refresh {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: #63a8ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(99, 168, 255, 0.1);
}

/* ========== 加载/空状态 ========== */
.loading-box {
  text-align: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}
.empty-box {
  text-align: center;
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 预约名单列表 ========== */
.list-header {
  padding: 20rpx 8rpx;
  margin-bottom: 12rpx;
}
.header-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.resv-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
  overflow: hidden;
}
.resv-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.resv-item:last-child {
  border-bottom: none;
}
.item-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
}
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.item-tag {
  font-size: 22rpx;
  color: #836fff;
  background: rgba(131, 111, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.item-detail {
  margin-top: 4rpx;
}
.detail-text {
  font-size: 24rpx;
  color: #999;
}
.detail-id {
  font-size: 20rpx;
  color: #bbb;
  word-break: break-all;
}
