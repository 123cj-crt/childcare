/**profile.wxss**/
.profile-page {
  padding: 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 通用 Hero 区 ========== */
.page-hero {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 60%, #7ec8f5 100%);
  overflow: hidden;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
}
.page-hero::before {
  content: "";
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  top: -80rpx;
  right: -80rpx;
}
.page-hero::after {
  content: "";
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  bottom: -60rpx;
  left: -40rpx;
}
.hero-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.hero-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}
.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========== 主体内容（与 Hero 重叠） ========== */
.page-body {
  margin-top: -40rpx;
  padding: 0 30rpx 60rpx;
  position: relative;
  z-index: 3;
}

/* ========== 用户卡片 ========== */
.user-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f4ff;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(131, 111, 255, 0.18);
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.username {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.edit-entry {
  padding: 6rpx 18rpx;
  background: rgba(131, 111, 255, 0.1);
  border-radius: 30rpx;
  border: 1rpx solid rgba(131, 111, 255, 0.25);
}
.edit-entry-text {
  font-size: 22rpx;
  color: #836fff;
}

.login-section {
  margin-top: 20rpx;
}
.login-btn {
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(131, 111, 255, 0.3);
}
.login-btn::after {
  border: none;
}

/* ========== 菜单列表 ========== */
.menu-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(99, 168, 255, 0.12);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #f5f7fc;
}
.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}
.names {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}
.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

/* ========== 编辑资料弹窗 ========== */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.edit-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.edit-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0 0 12rpx 0;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.avatar-btn::after {
  border: none;
}

.edit-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.avatar-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.form-item {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  border-bottom: 1rpx solid #eee;
  padding: 16rpx 8rpx;
  font-size: 30rpx;
  color: #333;
}

.edit-actions {
  display: flex;
  width: 100%;
  margin-top: 40rpx;
  justify-content: space-between;
}

.btn-cancel,
.btn-save {
  flex: 1;
  margin: 0 10rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
}

.btn-cancel {
  background: #f0f0f0;
  color: #666;
}
.btn-cancel::after {
  border: none;
}

.btn-save {
  background: linear-gradient(135deg, #836fff 0%, #63a8ff 100%);
  color: white;
}
.btn-save::after {
  border: none;
}