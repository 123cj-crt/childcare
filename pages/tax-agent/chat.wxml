<view class="page">
  <view class="chat-hero">
    <image class="chat-hero-image" src="/images/tax-agent/chat-bench.jpg" mode="aspectFill" />
    <view class="chat-hero-shade"></view>
    <view class="chat-hero-copy">
      <view class="chat-title">问问小税宝</view>
      <view class="chat-subtitle">生活里的财税小问题</view>
    </view>
    <view class="clear-button" bindtap="clearConversation">清空</view>
  </view>

  <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{scrollTo}}" scroll-with-animation="true" enable-flex="true">
    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-row {{item.role}}">
      <image wx:if="{{item.role === 'agent'}}" class="avatar-image" src="/images/tax-agent/mascot-study.jpg" mode="aspectFill" />
      <view wx:else class="avatar user-avatar">我</view>
      <view class="message-content">
        <view class="message-bubble" wx:if="{{item.role === 'user'}}" selectable="true">{{item.content}}</view>
        <view class="message-bubble" wx:else selectable="true">
          <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="index">
            <view class="markdown-block markdown-{{block.type}}" wx:if="{{block.type === 'list'}}">
              <view class="markdown-list-item" wx:for="{{block.items}}" wx:for-item="listItem" wx:key="index"><text class="markdown-list-marker">•</text><text class="markdown-list-content"><block wx:for="{{listItem.segments}}" wx:for-item="segment" wx:key="index"><text class="{{segment.strong ? 'markdown-strong' : ''}}">{{segment.text}}</text></block></text></view>
            </view>
            <view class="markdown-block markdown-{{block.type}}" wx:else><block wx:for="{{block.segments}}" wx:for-item="segment" wx:key="index"><text class="{{segment.strong ? 'markdown-strong' : ''}}">{{segment.text}}</text></block></view>
          </block>
        </view>
      </view>
    </view>
    <view class="typing" wx:if="{{isLoading}}"><view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view><text>小税宝正在思考…</text></view>
    <view class="request-error" wx:if="{{requestError}}"><view>{{requestError}}</view><view class="retry-button" bindtap="retryLastMessage">重试</view></view>
    <view id="chat-bottom" class="chat-bottom-anchor"></view>
  </scroll-view>

  <view class="quick-section" wx:if="{{showRecommendedQuestions && recommendedQuestions.length}}">
    <view class="quick-title">你可以这样问</view>
    <view class="quick-list">
      <view class="quick-item" wx:for="{{recommendedQuestions}}" wx:key="*this" bindtap="askRecommendedQuestion" data-question="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="input-bar">
    <input class="message-input" value="{{inputMessage}}" placeholder="输入想问的问题" bindinput="onInput" confirm-type="send" bindconfirm="sendFromInput" />
    <view class="send-button {{inputMessage && !isLoading ? 'active' : ''}}" bindtap="sendFromInput">发送</view>
  </view>
</view>

<tax-tabbar current="chat" />
