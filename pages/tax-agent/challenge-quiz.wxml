<view class="page quiz-page">
  <view class="quiz-hero">
    <image class="quiz-hero-image" src="/images/tax-agent/quiz-trophy.jpg" mode="aspectFill" />
    <view class="quiz-hero-shade"></view>
    <view class="quiz-hero-copy"><view class="quiz-topic-title">{{topic.title}}</view><view class="quiz-topic-desc">完成全部 {{topic.count}} 道小挑战</view></view>
    <view class="score">得分 {{score}}</view>
  </view>
  <view class="quiz" wx:if="{{!isLoading && !complete && currentQuestion}}">
    <view class="progress-row"><view class="progress">第 {{currentIndex + 1}} / {{topic.count}} 题</view><view class="progress-percent">{{currentIndex + 1}}/{{topic.count}}</view></view>
    <view class="progress-track"><view class="progress-value" style="width: {{(currentIndex + 1) / topic.count * 100}}%;"></view></view>
    <view class="question">{{currentQuestion.prompt}}</view>
    <view class="option-list"><view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="option {{selectedOptionKey === item.option_key ? 'selected' : ''}} {{selectedOptionKey === item.option_key && answered && isCorrect ? 'answer-correct' : ''}} {{selectedOptionKey === item.option_key && answered && !isCorrect ? 'answer-wrong' : ''}}" bindtap="selectOption" data-option-key="{{item.option_key}}"><view class="option-label">{{item.option_key}}</view><view class="option-content">{{item.content}}</view><view class="option-check" wx:if="{{selectedOptionKey === item.option_key}}">{{answered ? (isCorrect ? '✓' : '✕') : '✓'}}</view></view></view>
    <view class="feedback {{isCorrect ? 'good' : 'try'}}" wx:if="{{answered}}"><view class="feedback-title">{{isCorrect ? '答对啦！' : '再想一想'}}</view><view>{{explanation}}</view></view>
    <view class="request-error" wx:if="{{errorMessage}}"><view>{{errorMessage}}</view><view class="retry-button" bindtap="retrySubmit">重新提交</view></view>
    <view class="primary-button {{!selectedOptionKey && !answered ? 'disabled' : ''}}" wx:if="{{!answered}}" bindtap="checkAnswer">{{isSubmitting ? '正在提交…' : '确认答案'}}</view><view class="primary-button" wx:else bindtap="nextQuestion">{{nextQuestion ? '下一题' : '查看结果'}}</view>
  </view>
  <view class="quiz-reminder" wx:if="{{!isLoading && !complete && currentQuestion}}"><image class="quiz-reminder-image" src="/images/tax-agent/mascot-study.jpg" mode="aspectFill" /><view><view class="quiz-reminder-title">小税宝提醒</view><view class="quiz-reminder-text">遇到不懂的税务问题，可以先请家长一起了解哦。</view></view></view>
  <view class="result" wx:if="{{!isLoading && complete}}"><view class="result-badge">完成</view><view class="result-title">你答对了 {{score}} 题</view><view class="result-desc">{{score >= 5 ? '真棒！你正在把财税知识用到生活里。' : '认真思考就是收获，再试一次会更熟练。'}}</view><view class="primary-button" bindtap="startQuiz">再玩一次</view><view class="secondary-button" bindtap="chooseAnotherTopic">换个主题</view></view>
  <view class="loading" wx:if="{{isLoading}}">题目正在准备中…</view><view class="empty-state" wx:if="{{!isLoading && !complete && !currentQuestion && errorMessage}}"><view>{{errorMessage}}</view><view class="primary-button" bindtap="startQuiz">重新开始</view><view class="secondary-button" bindtap="chooseAnotherTopic">换个主题</view></view>
</view>
