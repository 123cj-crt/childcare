@import "./challenge.wxss";
.quiz-page { padding-bottom: 50rpx; }.quiz-hero { position: relative; height: 248rpx; overflow: hidden; border-radius: 0 0 36rpx 36rpx; }.quiz-hero-image, .quiz-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }.quiz-hero-shade { background: linear-gradient(90deg, rgba(245, 255, 251, .96), rgba(245, 255, 251, .66) 52%, rgba(245, 255, 251, .06)); }.quiz-hero-copy { position: relative; z-index: 1; width: 450rpx; padding: 62rpx 36rpx; }.quiz-topic-title { color: #0c5b4b; font-size: 42rpx; font-weight: 700; }.quiz-topic-desc { margin-top: 12rpx; color: #66857e; font-size: 25rpx; }.score { position: absolute; z-index: 2; top: 28rpx; right: 28rpx; padding: 12rpx 18rpx; border-radius: 26rpx; background: rgba(233, 250, 244, .88); color: #167d6d; font-size: 24rpx; font-weight: 700; }
.quiz { margin: 26rpx 24rpx 0; padding: 30rpx 26rpx; border: 1rpx solid #dceee8; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(31, 128, 112, .06); }.progress-row { display: flex; justify-content: space-between; align-items: center; }.progress { color: #2d8878; font-size: 28rpx; font-weight: 700; }.progress-percent { color: #86a7a0; font-size: 21rpx; }.progress-track { height: 14rpx; margin-top: 18rpx; overflow: hidden; border-radius: 14rpx; background: #e8efed; }.progress-value { height: 100%; min-width: 14rpx; border-radius: inherit; background: #20a28a; }.question { margin-top: 34rpx; color: #24443d; font-size: 34rpx; line-height: 1.48; font-weight: 700; }.option-list { margin-top: 26rpx; }.option { display: flex; align-items: center; min-height: 60rpx; margin-top: 16rpx; padding: 20rpx; border: 2rpx solid #e3efec; border-radius: 20rpx; background: #fff; color: #405a55; font-size: 27rpx; }.option.selected { border-color: #4db3a3; background: #edf9f5; }.option.correct { border-color: #4db3a3; background: #e7f8f0; }.option.wrong { border-color: #e07070; background: #fff0f0; }.option-label { flex: 0 0 46rpx; width: 46rpx; height: 46rpx; margin-right: 16rpx; border-radius: 50%; background: #edf5f3; color: #548a80; font-size: 23rpx; font-weight: 700; line-height: 46rpx; text-align: center; }.selected .option-label { background: #1e9b89; color: #fff; }.correct .option-label { background: #1e9b89; color: #fff; }.wrong .option-label { background: #e07070; color: #fff; }.option-content { flex: 1; }.option-check { margin-left: 10rpx; color: #1e9b89; font-size: 34rpx; font-weight: 700; }.option-cross { margin-left: 10rpx; color: #e07070; font-size: 34rpx; font-weight: 700; }.feedback { margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.65; }.feedback.good { background: #e7f8f0; color: #27785f; }.feedback.try { background: #fff3e9; color: #a66b32; }.feedback-title { margin-bottom: 8rpx; font-size: 30rpx; font-weight: 700; }.primary-button { margin-top: 30rpx; padding: 23rpx; border-radius: 22rpx; background: #1e9b89; color: #fff; text-align: center; font-size: 30rpx; font-weight: 700; }.primary-button.disabled { background: #cbded9; }.secondary-button { margin-top: 18rpx; padding: 18rpx; border-radius: 18rpx; color: #278b7b; text-align: center; font-size: 27rpx; }.request-error { margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: #fff3e9; color: #a66b32; font-size: 25rpx; line-height: 1.6; }.retry-button { display: inline-block; margin-top: 12rpx; padding: 8rpx 16rpx; border-radius: 20rpx; background: #1e9b89; color: #fff; }
.quiz-reminder { display: flex; align-items: center; gap: 18rpx; margin: 22rpx 24rpx 0; padding: 16rpx 20rpx; border: 1rpx solid #ffe0a0; border-radius: 24rpx; background: #fffaf0; }.quiz-reminder-image { flex: 0 0 96rpx; width: 96rpx; height: 96rpx; border-radius: 18rpx; }.quiz-reminder-title { color: #b87918; font-size: 27rpx; font-weight: 700; }.quiz-reminder-text { margin-top: 6rpx; color: #856b45; font-size: 22rpx; line-height: 1.5; }.result { margin: 88rpx 40rpx; padding: 56rpx 32rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(31, 128, 112, .06); text-align: center; }.result-badge { display: inline-block; padding: 10rpx 18rpx; border-radius: 28rpx; background: #e8f8f4; color: #208b79; font-size: 24rpx; }.result-title { margin-top: 24rpx; color: #27423d; font-size: 42rpx; font-weight: 700; }.result-desc { margin-top: 16rpx; color: #718b85; font-size: 27rpx; }.loading { padding: 140rpx 0; color: #7d958f; text-align: center; font-size: 28rpx; }.empty-state { margin: 90rpx 40rpx; color: #7d958f; text-align: center; font-size: 28rpx; }
