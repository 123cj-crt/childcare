.page { min-height: 100vh; background: #f7fbfa; padding-bottom: 48rpx; }
.hero { position: relative; overflow: hidden; padding: 56rpx 44rpx 54rpx; background: #1e9b89; color: #fff; border-radius: 0 0 40rpx 40rpx; }
.hero-badge { display: inline-block; padding: 8rpx 16rpx; border-radius: 20rpx; background: rgba(255,255,255,.2); font-size: 22rpx; }
.hero-title { margin-top: 22rpx; font-size: 48rpx; line-height: 1.3; font-weight: 700; }
.hero-desc { width: 470rpx; margin-top: 18rpx; font-size: 26rpx; line-height: 1.7; color: rgba(255,255,255,.9); }
.hero-mark { position: absolute; right: 42rpx; bottom: -38rpx; width: 180rpx; height: 180rpx; line-height: 180rpx; text-align: center; border-radius: 50%; background: rgba(255,255,255,.16); font-size: 88rpx; font-weight: 700; }
.feature-list { margin: 30rpx 28rpx 0; border-radius: 24rpx; background: #fff; overflow: hidden; }
.feature-item { display: flex; align-items: center; min-height: 132rpx; padding: 0 28rpx; border-bottom: 1rpx solid #edf3f1; }
.feature-item:last-child { border-bottom: 0; }
.feature-icon { width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 20rpx; background: #e1f7f1; color: #168573; font-size: 32rpx; font-weight: 700; }
.feature-icon.light { background: #e9f1ff; color: #5886d7; }
.feature-icon.warm { background: #fff1da; color: #d28b25; }
.feature-copy { flex: 1; margin-left: 22rpx; }
.feature-title { font-size: 30rpx; color: #243a37; font-weight: 700; }
.feature-desc { margin-top: 8rpx; color: #7b918d; font-size: 24rpx; }
.feature-arrow { color: #9ab0ac; font-size: 42rpx; }
.section { margin: 40rpx 28rpx 0; }
.section-title { margin-bottom: 18rpx; color: #294440; font-size: 30rpx; font-weight: 700; }
.question-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.question-item { padding: 14rpx 20rpx; border-radius: 32rpx; background: #e7f8f4; color: #28736a; font-size: 25rpx; }
